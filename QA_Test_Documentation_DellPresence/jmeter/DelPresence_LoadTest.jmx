<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="DelPresence Load Test" enabled="true">
<stringProp name="TestPlan.comments">Beban 250 virtual user, 1 iterasi: login lalu membuka 13 halaman admin. Parameter: -Jthreads -Jrampup -JwebHost -JapiHost -Jusername -Jpassword</stringProp>
<boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
